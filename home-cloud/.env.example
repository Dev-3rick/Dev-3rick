# Copie para .env e troque TODAS as senhas.
# Gerar senha forte: openssl rand -base64 24

# Pasta onde ficam todos os dados (de preferência no HD maior)
DATA_DIR=/srv/nuvem

# Banco de dados
DB_ROOT_PASSWORD=troque-esta-senha-root
DB_PASSWORD=troque-esta-senha-db

# Usuário administrador do Nextcloud
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=troque-esta-senha-admin

# Endereços pelos quais você acessa (separados por espaço):
# IP da rede local e IP/nome do Tailscale
NC_TRUSTED_DOMAINS=192.168.0.100 servidor 100.64.0.1

# Ajuste conforme a RAM: 512M para 4 GB, 1G para 8 GB ou mais
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=10G
